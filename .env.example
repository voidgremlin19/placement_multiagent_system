# Placement Agent — local secrets. NEVER commit this file.
# Get a key at https://aistudio.google.com/apikey

# ---- Required: paste your key between the quotes ----
GOOGLE_API_KEY="your-key-here"

# Use Google AI Studio (a plain API key) instead of Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ---- Optional: only if you switch to Vertex AI ----
# Set GOOGLE_GENAI_USE_VERTEXAI=TRUE above, drop GOOGLE_API_KEY,
# run `gcloud auth application-default login`, then fill these in.
# GOOGLE_CLOUD_PROJECT=""
# GOOGLE_CLOUD_LOCATION="us-central1"

# ---- Required only for `python deploy/deploy_agent_engine.py` ----
# A Cloud Storage bucket (name only, no gs:// prefix) in the same
# project/region, used to stage the deployment package.
# GOOGLE_CLOUD_STAGING_BUCKET=""

# ---- Filled in automatically after you run deploy_agent_engine.py ----
# Paste the printed resource name here to use query_agent_engine.py /
# delete_agent_engine.py against that deployment.
# AGENT_ENGINE_RESOURCE_NAME=""
